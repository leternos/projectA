{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "title": "Pilot run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_filename",
    "source_sha256",
    "pdf_page_range",
    "dpi",
    "extraction_method",
    "extraction_date",
    "copyright_note"
  ],
  "properties": {
    "source_filename": { "type": "string" },
    "source_sha256": { "type": "string" },
    "pdf_page_range": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 2,
      "maxItems": 2,
      "description": "[start, end] inclusive, 0-based PDF page indices"
    },
    "dpi": { "type": "integer" },
    "extraction_method": {
      "type": "string",
      "description": "e.g. claude-vision-manual-v1"
    },
    "extraction_date": {
      "type": "string",
      "description": "ISO 8601 date"
    },
    "copyright_note": {
      "type": "string",
      "description": "Carries the public-domain/edition caveat alongside the data it applies to"
    }
  }
}
